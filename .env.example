# DRIP — optional API keys. App works fully WITHOUT these (keyless features stay on).
# Add the ones you want, then set them in Vercel → Project → Settings → Environment Variables
# (or locally for `vercel dev`). All are FREE tiers.

# --- AI Stylist — set ANY one (or several); tried in this order: OpenRouter, NVIDIA, HuggingFace ---
# OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# NVIDIA NIM (free dev tier): https://build.nvidia.com  → key starts with nvapi-
NVIDIA_API_KEY=
NVIDIA_MODEL=
# HuggingFace Inference: https://huggingface.co/settings/tokens  → starts with hf_
HF_API_KEY=
HF_MODEL=

# --- More sneaker data / exact product info (optional; app already self-hosts 42 shoes) ---
# Free signup: https://sneakersapi.dev  (or RapidAPI "The Sneaker Database")
SNEAKERS_API_KEY=

# --- YouTube trend videos in the community feed (optional) ---
# Free: Google Cloud Console → YouTube Data API v3 key
YOUTUBE_API_KEY=

# --- Reddit r/Sneakers in the community feed ---
# Sneaker NEWS feeds are already live with NO key. Reddit blocks anonymous datacenter
# requests, so live Reddit posts need free app credentials:
# reddit.com/prefs/apps → "create app" → type "script" → copy the id + secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
